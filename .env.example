# IP del PC en la red Wi-Fi / LAN (ipconfig en Windows)
HOST_LAN_IP=192.168.1.50
AUTH_MODE=mock
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
JWT_SECRET=cambia-esto
# false permite reservar a cualquier hora (solo para probar). Reservas hasta las 11:30.
ENFORCE_RESERVATION_WINDOW=true
# Minutos para pagar antes de que el pedido expire y libere stock.
ORDER_TTL_MINUTES=15
QR_SECRET=cambia-esto-tambien
WEBPAY_ENV=integration
WEBPAY_RETURN_URL=http://${HOST_LAN_IP}:3000/payments/webpay/return
